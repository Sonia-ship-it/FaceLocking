# Virtual Environment
.venv/
venv/
ENV/
env/

# Python cache & bytecode
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/

# Large ONNX Model weights (>100MB exceeds GitHub file limit; downloaded with src/download_model.py)
models/*.onnx
models/*.zip
models/*.tmp

# Biometric enrollment photos and local database
data/enroll/*
!data/enroll/.gitkeep
data/db/*
!data/db/.gitkeep

# Temporary files
*.tmp
.DS_Store
Thumbs.db
branch_structure.json
temp_auto_push.bat
temp_interactive_push.bat
.gitignore
